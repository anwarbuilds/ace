# Copy this file to the repository root as .env on the Oracle VM.
# Never commit the completed file.
ACE_DOMAIN=ace.example.com
ACE_DB_NAME=ace
ACE_DB_USER=ace
ACE_DB_PASSWORD=replace_with_a_long_random_value
DATABASE_URL=postgresql+psycopg://ace:replace_with_a_long_random_value@postgres:5432/ace

ACE_AUTH=required
SESSION_DAYS=30
SETUP_TOKEN=replace_with_a_different_long_random_value
PUBLIC_BASE_URL=https://ace.example.com
WEB_BASE_URL=https://ace.example.com

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://ace.example.com/api/auth/google/callback

RESEND_API_KEY=
MAIL_FROM=ACE <alerts@example.com>
ALERT_EMAIL=
DISPLAY_TIMEZONE=America/Los_Angeles
MAX_ALERT_POSTING_AGE_DAYS=10
ALERT_ON_UNKNOWN_POSTING_AGE=false
ACE_TARGET_PROFILE=early-career
API_DOCS=false

# Optional private Object Storage backup bucket. The backup script refuses
# uploads once ACE objects would exceed this byte ceiling.
OCI_BACKUP_BUCKET=
ACE_BACKUP_MAX_REMOTE_BYTES=16106127360
