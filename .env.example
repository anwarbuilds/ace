# ACE local development configuration.
#
# This file is safe to commit because it contains example values only.
# Real credentials belong in .env, which is ignored by Git.

# ----------------------------------------------------------------------
# PostgreSQL
# ----------------------------------------------------------------------

ACE_DB_NAME=ace
ACE_DB_USER=ace
ACE_DB_PASSWORD=ace_local_dev
ACE_DB_PORT=5433

DATABASE_URL=postgresql+psycopg://ace:ace_local_dev@localhost:5433/ace

# ----------------------------------------------------------------------
# Email notification transport
# ----------------------------------------------------------------------
#
# Gmail development configuration:
#
# - SMTP host: smtp.gmail.com
# - SMTP port: 587
# - STARTTLS enabled
# - SMTP_PASSWORD must be a Google App Password.
#
# Never place real SMTP credentials in this file.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-google-app-password

SMTP_FROM_EMAIL=your-email@gmail.com
NOTIFICATION_TO_EMAIL=recipient@example.com

SMTP_USE_STARTTLS=true
SMTP_TIMEOUT_SECONDS=20
# ----------------------------------------------------------------------
# Alert freshness policy
# ----------------------------------------------------------------------
#
# ACE persists every discovered job. Freshness controls only whether a
# newly observed job is worth emailing about.
#
# The first time ACE polls a company, every open posting looks "NEW"
# because it is new to ACE, not because it opened recently. Freshness
# stops those historical postings from producing alerts, without
# suppressing genuinely recent roles at newly discovered companies.
#
# A job held back by freshness is still stored and still searchable.

MAX_ALERT_POSTING_AGE_DAYS=30

# When a posting states no date, ACE will not claim it is fresh.
# Set to true only if you would rather see unknown-age postings.
ALERT_ON_UNKNOWN_POSTING_AGE=false

# ----------------------------------------------------------------------
# Digest delivery
# ----------------------------------------------------------------------
#
# ACE sends one email per delivery window, containing every qualifying
# job accumulated since the previous digest.
#
#   zero qualifying jobs -> zero emails
#   many qualifying jobs -> one email
#
# One or two windows per day are allowed. Times are local wall-clock in
# NOTIFICATION_DIGEST_TIMEZONE, 24-hour HH:MM.

NOTIFICATION_DIGEST_TIMEZONE=America/Los_Angeles
NOTIFICATION_DIGEST_TIMES=07:30,17:30

# Maximum opportunities in one digest. The remainder is reported in the
# next digest rather than producing an email long enough for Gmail to
# clip it.
NOTIFICATION_DIGEST_MAX_JOBS=100

# ----------------------------------------------------------------------
# Web application
# ----------------------------------------------------------------------
#
# The web app is a read-only surface over the same database the
# scheduler writes. It never fetches from an ATS and never sends email.

ACE_WEB_PORT=8000
