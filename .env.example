# ACE local development configuration.
#
# This file is safe to commit because it contains example values only.
# Real credentials belong in .env, which is ignored by Git.

# ----------------------------------------------------------------------
# PostgreSQL
# ----------------------------------------------------------------------

ACE_DB_NAME=ace
ACE_DB_USER=ace
ACE_DB_PASSWORD=ace_local_dev
ACE_DB_PORT=5433

DATABASE_URL=postgresql+psycopg://ace:ace_local_dev@localhost:5433/ace

# ----------------------------------------------------------------------
# Alert freshness policy
# ----------------------------------------------------------------------
#
# ACE persists every discovered job. Freshness controls only whether a
# newly observed job is worth emailing about.
#
# The first time ACE polls a company, every open posting looks "NEW"
# because it is new to ACE, not because it opened recently. Freshness
# stops those historical postings from producing alerts, without
# suppressing genuinely recent roles at newly discovered companies.
#
# A job held back by freshness is still stored and still searchable.

MAX_ALERT_POSTING_AGE_DAYS=10

# When a posting states no date, ACE will not claim it is fresh.
# Set to true only if you would rather see unknown-age postings.
ALERT_ON_UNKNOWN_POSTING_AGE=false

# Internships are out of scope; set INCLUDE_INTERNSHIPS in code to change.


# ----------------------------------------------------------------------
# Web application
# ----------------------------------------------------------------------
#
# The web app is a read-only surface over the same database the
# scheduler writes. It never fetches from an ATS and never sends email.

ACE_WEB_PORT=8000

# ----------------------------------------------------------------------
# Who the gate is choosing for
# ----------------------------------------------------------------------
#
# early-career (default): open-ended "3+ years" postings are rejected.
# sde2: the same, except "3+ years" is admitted, so SDE II roles asking
# three years appear. 4+ years, senior, staff and manager stay out.
# Before switching, see what would change on your own data (read-only):
#   .venv/bin/python -m backend.scripts.gate_dry_run --profile sde2
# Then set this, rebuild, and restart; stored decisions re-evaluate.

ACE_TARGET_PROFILE=early-career


# Sign-in. "required" (the default): every /api/ route needs the
# owner's browser session or the paired extension's token. Create the
# owner once, at a hidden password prompt:
#   docker exec -it ace-web-1 python -m backend.scripts.create_owner you@example.com
# "disabled" is the rollback switch: no sign-in, and ace then answers
# only this computer or your private network, never a public address.

ACE_AUTH=required

# How long a browser stays signed in, in days.
SESSION_DAYS=30

# Where the Next.js app is served, used in password reset emails.
WEB_BASE_URL=http://localhost:3000

# Interactive API docs at /docs. Off unless you want them.
API_DOCS=false
