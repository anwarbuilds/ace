# ACE local development configuration.
#
# This file is safe to commit because it contains example values only.
# Real credentials belong in .env, which is ignored by Git.

# ----------------------------------------------------------------------
# PostgreSQL
# ----------------------------------------------------------------------

ACE_DB_NAME=ace
ACE_DB_USER=ace
ACE_DB_PASSWORD=ace_local_dev
ACE_DB_PORT=5433

DATABASE_URL=postgresql+psycopg://ace:ace_local_dev@localhost:5433/ace

# ----------------------------------------------------------------------
# Email notification transport
# ----------------------------------------------------------------------
#
# Gmail development configuration:
#
# - SMTP host: smtp.gmail.com
# - SMTP port: 587
# - STARTTLS enabled
# - SMTP_PASSWORD must be a Google App Password.
#
# Never place real SMTP credentials in this file.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-google-app-password

SMTP_FROM_EMAIL=your-email@gmail.com
NOTIFICATION_TO_EMAIL=recipient@example.com

SMTP_USE_STARTTLS=true
SMTP_TIMEOUT_SECONDS=20