# ACE local development database configuration.
#
# This file is safe to commit because it contains development-only example
# values. Real credentials belong in .env, which is ignored by Git.

ACE_DB_NAME=ace
ACE_DB_USER=ace
ACE_DB_PASSWORD=ace_local_dev
ACE_DB_PORT=5433

DATABASE_URL=postgresql+psycopg://ace:ace_local_dev@localhost:5433/ace