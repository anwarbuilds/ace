# Python virtual environment
.venv/

# Python generated files
__pycache__/
*.py[cod]

# Python tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Environment variables and secrets
.env
.env.*
!.env.example

# Node / Next.js
node_modules/
.next/

# IDE / editor configuration
.vscode/
.idea/

# Operating system files
.DS_Store
Thumbs.db
# Local scratch notes
requiremnts1.txt

# Personal data that must never reach a public repo.
#
# The exported application sheet, a resume, or a database dump landing
# in this folder would otherwise be picked up by `git add -A` without
# anyone noticing. Nothing here is a build artefact; these are ignored
# because of what is in them. Use `git add -f` if a genuine fixture
# ever needs one of these extensions.
*.csv
*.tsv
*.xlsx
*.xlsm
*.xls
*.pdf
*.docx
*.doc
*.sql
*.dump
*.sqlite
*.sqlite3
*.db
ace-applications*.csv
*resume*
*Resume*
# ...but not the code and notes about resumes. The rule above once hid
# every Resume Studio page and a migration from git, so the app worked
# where it was written and 404ed everywhere else. Real resumes are PDFs,
# DOCX or text files, still ignored by name and by the extensions above.
!*resume*/
!*Resume*/
!*resume*.py
!*resume*.ts
!*resume*.tsx
!*Resume*.tsx
!docs/knowledge/*resume*.md

# The durable memory file stays local, by the user's decision.
#
# It is the one document that records who this is for and what they
# have applied to, and no amount of scrubbing makes that safe to
# publish from a repo owned under a real name. Keeping it out entirely
# is the honest answer rather than editing around the problem.
docs/ACE-KNOWLEDGE.md

# The prompt used to start a fresh session carries private context (profile,
# cleanup items). docs/HANDOFF.md is the public-safe brief it points to.
docs/NEXT-SESSION-PROMPT.md

# Demo database built by backend/scripts/seed_demo.py
ace-demo.db

# Local design references (the approved prototype and directive); kept out of the public repo.
/design/

# Local browser comparison captures generated during visual review.
/artifacts/

# Read-only comparison snapshots can contain real job titles and links.
/private-reports/

# Private operational archives and database recovery material.
/private-backups/
