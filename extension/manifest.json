{
  "manifest_version": 3,
  "name": "ACE Autofill",
  "version": "2.0.0",
  "description": "Fills application forms on job portals from the answer bank in your local ACE instance. It never submits anything.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.myworkdayjobs.com/*",
        "https://*.myworkday.com/*",
        "https://*.myworkdaysite.com/*",
        "https://*.greenhouse.io/*",
        "https://*.lever.co/*",
        "https://*.ashbyhq.com/*",
        "https://*.oraclecloud.com/*",
        "https://*.successfactors.com/*",
        "https://*.successfactors.eu/*",
        "https://*.sapsf.com/*",
        "https://*.taleo.net/*",
        "https://*.smartrecruiters.com/*",
        "https://*.icims.com/*",
        "https://*.jobvite.com/*",
        "https://*.workable.com/*",
        "https://*.applytojob.com/*",
        "https://*.bamboohr.com/*",
        "https://*.eightfold.ai/*",
        "https://*.avature.net/*",
        "https://*.phenompeople.com/*",
        "https://*.ultipro.com/*",
        "https://*.ukg.com/*",
        "https://*.paylocity.com/*",
        "https://workforcenow.adp.com/*",
        "https://myjobs.adp.com/*",
        "https://*.dayforcehcm.com/*",
        "https://*.recruitee.com/*",
        "https://*.breezy.hr/*",
        "https://*.teamtailor.com/*",
        "https://*.pinpointhq.com/*",
        "https://ats.rippling.com/*",
        "https://jobs.gem.com/*",
        "https://app.dover.com/*",
        "https://wellfound.com/*",
        "https://*.joinhandshake.com/*"
      ],
      "js": [
        "fields.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ACE Autofill"
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
